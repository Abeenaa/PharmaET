{
  "name": "pharmaet",
  "version": "1.0.0",
  "description": "Multi-branch pharmacy management system",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "cd server && npm run start:dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
