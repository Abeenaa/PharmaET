// This is our Prisma schema file,


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  BRANCH_ADMIN
  PHARMACIST
  CASHIER
}

enum BatchStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

enum POStatus {
  DRAFT
  PENDING
  RECEIVED
  CANCELLED
}

enum GRNStatus {
  DRAFT
  FINALIZED
}

enum AdjustmentReason {
  DAMAGE
  LOSS
  EXPIRED
  CORRECTION
}

enum AlertType {
  LOW_STOCK
  EXPIRING_SOON
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Models

model Branch {
  id              String    @id @default(uuid())
  name            String
  location        String
  license_number  String    @unique
  contact_phone   String?
  contact_email   String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  users           User[]
  sales           Sale[]
  purchase_orders PurchaseOrder[]
  grns            GRN[]
  stock_adjustments StockAdjustment[]
  alerts          Alert[]
  audit_logs      AuditLog[]

  @@index([license_number])
  @@index([is_active])
}

model User {
  id                      String    @id @default(uuid())
  branch_id               String?
  email                   String    @unique
  password_hash           String
  name                    String
  phone                   String?
  role                    UserRole
  is_active               Boolean   @default(true)
  requires_password_change Boolean  @default(true)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  // Relations
  branch          Branch?           @relation(fields: [branch_id], references: [id])
  sales           Sale[]
  grns            GRN[]
  stock_adjustments StockAdjustment[]
  audit_logs      AuditLog[]
  purchase_orders PurchaseOrder[]

  @@index([email])
  @@index([branch_id])
  @@index([is_active])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  // Relations
  medicines   Medicine[]

  @@index([is_active])
}

model Medicine {
  id            String    @id @default(uuid())
  sku           String    @unique
  name          String
  generic_name  String
  strength      String?
  form          String?
  barcode       String    @unique
  category_id   String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  category      Category        @relation(fields: [category_id], references: [id])
  batches       MedicineBatch[]
  sale_items    SaleItem[]
  po_items      POItem[]
  stock_adjustments StockAdjustment[]
  alerts        Alert[]

  @@index([barcode])
  @@index([sku])
  @@index([category_id])
}

model MedicineBatch {
  id            String    @id @default(uuid())
  medicine_id   String
  batch_number  String
  quantity      Int       @default(0)
  expiry_date   DateTime
  status        BatchStatus @default(ACTIVE)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  medicine      Medicine  @relation(fields: [medicine_id], references: [id])
  sale_items    SaleItem[]

  @@index([medicine_id])
  @@index([expiry_date])
  @@index([status])
}

model Supplier {
  id              String    @id @default(uuid())
  name            String
  contact_person String?
  email           String?
  phone           String?
  address         String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  purchase_orders PurchaseOrder[]

  @@index([is_active])
}

model PurchaseOrder {
  id            String    @id @default(uuid())
  po_number     String    @unique
  supplier_id   String
  branch_id     String
  status        POStatus  @default(DRAFT)
  created_by    String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  supplier      Supplier  @relation(fields: [supplier_id], references: [id])
  branch        Branch    @relation(fields: [branch_id], references: [id])
  created_user  User      @relation(fields: [created_by], references: [id])
  po_items      POItem[]
  grns          GRN[]

  @@index([po_number])
  @@index([supplier_id])
  @@index([branch_id])
  @@index([status])
}

model POItem {
  id                String  @id @default(uuid())
  po_id             String
  medicine_id       String
  quantity_ordered  Int
  quantity_received Int     @default(0)
  created_at        DateTime @default(now())

  // Relations
  purchase_order    PurchaseOrder @relation(fields: [po_id], references: [id])
  medicine          Medicine      @relation(fields: [medicine_id], references: [id])

  @@index([po_id])
  @@index([medicine_id])
}

model GRN {
  id            String    @id @default(uuid())
  grn_number    String    @unique
  po_id         String
  branch_id     String
  status        GRNStatus @default(DRAFT)
  received_by   String
  received_at   DateTime?
  created_at    DateTime  @default(now())

  // Relations
  purchase_order PurchaseOrder @relation(fields: [po_id], references: [id])
  branch        Branch        @relation(fields: [branch_id], references: [id])
  user          User          @relation(fields: [received_by], references: [id])
  grn_items     GRNItem[]

  @@index([grn_number])
  @@index([po_id])
  @@index([branch_id])
  @@index([status])
}

model GRNItem {
  id                String    @id @default(uuid())
  grn_id            String
  po_item_id        String
  quantity_received Int
  batch_number      String
  expiry_date       DateTime
  created_at        DateTime  @default(now())

  // Relations
  grn               GRN @relation(fields: [grn_id], references: [id])

  @@index([grn_id])
}

model Sale {
  id              String    @id @default(uuid())
  transaction_id  String    @unique
  branch_id       String
  cashier_id      String
  total_amount    Decimal   @db.Decimal(12, 2)
  created_at      DateTime  @default(now())

  // Relations
  branch          Branch    @relation(fields: [branch_id], references: [id])
  cashier         User      @relation(fields: [cashier_id], references: [id])
  sale_items      SaleItem[]

  @@index([transaction_id])
  @@index([branch_id])
  @@index([cashier_id])
  @@index([created_at])
}

model SaleItem {
  id              String    @id @default(uuid())
  sale_id         String
  medicine_id     String
  batch_id        String
  quantity        Int
  unit_price      Decimal   @db.Decimal(10, 2)
  created_at      DateTime  @default(now())

  // Relations
  sale            Sale      @relation(fields: [sale_id], references: [id])
  medicine        Medicine  @relation(fields: [medicine_id], references: [id])
  batch           MedicineBatch @relation(fields: [batch_id], references: [id])

  @@index([sale_id])
  @@index([medicine_id])
}

model StockAdjustment {
  id              String    @id @default(uuid())
  medicine_id     String
  branch_id       String
  reason          AdjustmentReason
  quantity_change Int
  performed_by    String
  created_at      DateTime  @default(now())

  // Relations
  medicine        Medicine  @relation(fields: [medicine_id], references: [id])
  branch          Branch    @relation(fields: [branch_id], references: [id])
  user            User      @relation(fields: [performed_by], references: [id])

  @@index([medicine_id])
  @@index([branch_id])
  @@index([created_at])
}

model Alert {
  id              String    @id @default(uuid())
  branch_id       String
  medicine_id     String
  alert_type      AlertType
  is_read         Boolean   @default(false)
  acknowledged_by String?
  acknowledged_at DateTime?
  created_at      DateTime  @default(now())

  // Relations
  branch          Branch?   @relation(fields: [branch_id], references: [id])
  medicine        Medicine  @relation(fields: [medicine_id], references: [id])

  @@index([branch_id])
  @@index([medicine_id])
  @@index([alert_type])
  @@index([is_read])
}

model AuditLog {
  id              String    @id @default(uuid())
  entity_type     String
  entity_id       String
  action          AuditAction
  old_values      Json?
  new_values      Json?
  performed_by    String
  branch_id       String?
  created_at      DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [performed_by], references: [id])
  branch          Branch?   @relation(fields: [branch_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([performed_by])
  @@index([branch_id])
  @@index([created_at])
}

model OfflinePendingSync {
  id              String    @id @default(uuid())
  entity_type     String
  entity_id       String?
  action          AuditAction
  payload         Json
  status          String    @default("PENDING")
  error_message   String?
  created_at      DateTime  @default(now())
  synced_at       DateTime?

  @@index([status])
  @@index([created_at])
}
